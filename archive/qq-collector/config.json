{
  "milky": {
    "host": "127.0.0.1",
    "port": 3000,
    "prefix": "",
    "accessToken": ""
  },
  "storage": {
    "dir": "./data"
  },
  "listen": {
    "groups": [],
    "friends": []
  },
  "filters": {
    "ignoreSelf": true,
    "keywords": []
  },
  "reply": {
    "enabled": true,
    "triggers": [
      { "match": "exact", "keyword": "ping", "reply": "pong" },
      { "match": "contains", "keyword": "在吗", "reply": "在的，有什么事？" }
    ],
    "commands": [
      { "name": "help", "description": "显示帮助", "action": "help" },
      { "name": "about", "description": "关于本机器人", "action": "about" }
    ]
  }
}
