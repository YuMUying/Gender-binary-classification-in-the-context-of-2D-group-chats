{
  "enabled": true,
  "allow_users": [0],
  "providers": {
    "deepseek": {
      "type": "openai",
      "baseURL": "https://api.deepseek.com",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "apiKey": "sk-xxxxxx填你的Key"
    }
  },
  "default_model": "chat",
  "persona": "（可自定义人设；留空则用内置默认——口语化中文助手，支持角色扮演，主动用工具查树莓派状态）",
  "limits": {
    "dailyTokenBudget": 2000000,
    "dailyCallBudget": 500,
    "cooldownMs": 2000
  }
}
